msgstr "Музыку и сигналы отрисовывает ESP."

msgid "Music is rendered on this computer."
msgstr "Музыку отрисовывает компьютер."

msgid "Preparing Wi-Fi update"
msgstr "Подготовка обновления по Wi-Fi"

msgid "Preset name"
msgstr "Имя пресета"

msgid "Repeat on steady sound, ms (0 disables)"
msgstr "Повтор на ровном звуке, мс (0 — выкл.)"

msgid "Repeated pulses must be at least 180 ms apart"
msgstr "Интервал повторных импульсов должен быть не меньше 180 мс"

msgid "Save preset"
msgstr "Сохранить пресет"

msgid "Saved on this computer. ESP settings could not be confirmed; reconnect and save again."
msgstr "Сохранено на компьютере. Не удалось подтвердить настройки ESP; восстановите связь и сохраните ещё раз."

