msgstr "Сохранённые пресеты"

msgid "The update keeps your settings and leaves lighting off. First OTA setup requires one USB update."
msgstr "Обновление сохраняет настройки и оставляет подсветку выключенной. Для первого запуска OTA нужно одно обновление по USB."

msgid "Unknown preset action"
msgstr "Неизвестное действие с пресетом"

msgid "Update firmware over Wi-Fi"
msgstr "Обновить прошивку по Wi-Fi"

msgid "Uploading firmware over Wi-Fi"
msgstr "Загрузка прошивки по Wi-Fi"

msgid "Wait for connection, seconds"
msgstr "Ожидание подтверждения, с"

msgid "Wallpaper connection timeout"
msgstr "Отключение подсветки обоев при потере связи"
